generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum ProductType {
  LOCAL
  INTERNATIONAL
}

enum PaymentStatus {
  PENDING

  PARTIAL

  PAID

  FAILED

  EXPIRED

  REFUNDED
}

enum PaymentType {
  PRODUCT

  SHIPPING

  FULL
}

enum OrderStatus {
  PENDING_PAYMENT

  PARTIALLY_PAID

  PAID

  DELIVERED

  CANCELLED
}

enum TrackingStatus {
  ORDER_VALIDATED

  PURCHASED

  PREPARING

  IN_CHINA

  IN_TRANSIT

  ARRIVED_DRC

  OUT_FOR_DELIVERY

  DELIVERED
}

enum InventoryMovementType {
  IN
  OUT
}

model User {
  id String @id @default(cuid())

  email String @unique

  phone String? @unique

  password String

  role Role @default(USER)

  cart Cart?

  orders Order[]

  quotes InternationalQuote[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Product {
  id String @id @default(cuid())

  name String

  slug String @unique

  description String?

  price Decimal @db.Decimal(10, 2)

  margin Decimal @default(0) @db.Decimal(10, 2)

  currency String @default("USD")

  type ProductType @default(LOCAL)

  isActive Boolean @default(true)

  inventory Inventory?

  images ProductImage[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  cartItems CartItem[]

  orderItems OrderItem[]

  movements InventoryMovement[]
}

model ProductImage {
  id String @id @default(cuid())

  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  imageUrl String

  position Int

  createdAt DateTime @default(now())
}

model Inventory {
  id String @id @default(cuid())

  productId String @unique

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity Int @default(0)

  updatedAt DateTime @updatedAt
}

model Cart {
  id String @id @default(cuid())

  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  items CartItem[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model CartItem {
  id String @id @default(cuid())

  cartId String

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String

  product Product @relation(fields: [productId], references: [id])

  quantity Int @default(1)

  @@unique([cartId, productId])
}

model Order {
  id String @id @default(cuid())

  userId String

  user User @relation(fields: [userId], references: [id])

  status OrderStatus @default(PENDING_PAYMENT)

  productsAmount Decimal @db.Decimal(10, 2)

  shippingAmount Decimal @default(0) @db.Decimal(10, 2)

  totalAmount Decimal @db.Decimal(10, 2)

  items OrderItem[]

  payments Payment[]

  trackingEvents TrackingEvent[]

  createdAt DateTime @default(now())
}

model OrderItem {
  id String @id @default(cuid())

  orderId String

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String

  product Product @relation(fields: [productId], references: [id])

  quantity Int

  basePrice Decimal @default(0) @db.Decimal(10, 2)

  margin Decimal @default(0) @db.Decimal(10, 2)

  price Decimal @db.Decimal(10, 2)
}

model Payment {
  id String @id @default(cuid())

  orderId String

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  amount Decimal @db.Decimal(10, 2)

  type PaymentType @default(FULL)

  status PaymentStatus @default(PENDING)

  providerReference String?

  webhookLogs PaymentWebhookLog[]

  createdAt DateTime @default(now())
}

model TrackingEvent {
  id String @id @default(cuid())

  orderId String

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status TrackingStatus

  message String?

  createdAt DateTime @default(now())
}

model InternationalQuote {
  id String @id @default(cuid())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  productUrl String

  productName String?

  productPrice Decimal @db.Decimal(10, 2)

  shippingCost Decimal @db.Decimal(10, 2)

  customsCost Decimal @db.Decimal(10, 2)

  commissionCost Decimal @db.Decimal(10, 2)

  totalPrice Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
}

model Setting {
  id String @id @default(cuid())

  key String @unique

  value String

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model PaymentWebhookLog {
  id String @id @default(cuid())

  depositId String

  paymentId String?

  payment Payment? @relation(fields: [paymentId], references: [id])

  status String

  payload Json

  processed Boolean @default(false)

  error String?

  createdAt DateTime @default(now())
}


model InventoryMovement {

  id String @id @default(cuid())

  productId String

  product Product @relation( fields:[productId], references:[id], onDelete: Cascade )

  quantity Int

  type InventoryMovementType

  reason String?

  createdAt DateTime @default(now())

}


model GlobalSettings {

  id String @id @default(cuid())

  commissionRate Decimal @db.Decimal(10,2)

  chinaPricePerKg Decimal @db.Decimal(10,2)

  fixedFee Decimal @db.Decimal(10,2)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

}
